# Splits one line of assembly into tokens. A comment runs from `;` to the
# end of the line. Numbers are decimal, `0x` hexadecimal, `0b` binary or `0o`
# octal, and may part their digits with `_`; a character literal is its byte.

export {Token.*, tokenize, parse_int, is_local}

Token : [
  # A name: an opcode, register, label or directive, perhaps `.`-prefixed
  # and `::`-qualified, as `string::.loop`.
  Word(Str),
  Number(U64),
  # A string literal's bytes, escapes resolved.
  Text(List(U8)),
  # Punctuation and operators.
  Op(Str),
].(
  to_str : Token -> Str
  to_str(Word(w)) -> w
  to_str(Number(n)) -> "${n}"
  to_str(Text(bytes)) -> "\"${Str.from_utf8(bytes).ok_or("?")}\""
  to_str(Op(op)) -> op

  equals : (Token, Token) -> Bool
)

# Whether a name is a local label: its last `::` part begins with `.`.
is_local : Str -> Bool
is_local(name) -> name.split("::").last().ok_or(name).starts_with(".")

Lexed = [Skip, Stop, Got(Token)]

tokenize : List(U8) -> Result(List(Token), Str)
tokenize(line) -> (
  tokens = []
  i = 0
  while i < line.len() do (
    (lexed, next) = lex_one(line, i)?
    i = next
    lexed is (
      Skip continue
      Stop break
      Got(token) then (tokens = tokens.append(token))
    )
  )
  Ok(tokens)
)

is_digit : U8 -> Bool
is_digit(c) -> c >= '0' & c <= '9'

is_name_start : U8 -> Bool
is_name_start(c) -> c.is_ascii_letter() | c == '_' | c == '.'

is_name : U8 -> Bool
is_name(c) -> is_name_start(c) | is_digit(c)

lex_one : (List(U8), Nat) -> Result((Lexed, Nat), Str)
lex_one(line, i) -> (
  c = line.get_or(i, 0)
  next = line.get_or(i + 1, 0)
  if c == ' ' | c == '\t' | c == '\r' return Ok((Skip, i + 1))
  if c == ';' return Ok((Stop, i))
  if is_digit(c) return number(line, i)
  if is_name_start(c) return Ok(name(line, i))
  if c == '\'' return character(line, i + 1)
  if c == '"' return string(line, i + 1)
  pair = [c, next]
  if ["<<", ">>", "<=", ">=", "==", "!=", "&&", "||"].any(|op| op.to_utf8() == pair) return Ok((Got(Op(text([c, next]))), i + 2))
  if "+-*/%&|^~!<>()[],:$".to_utf8().contains(c) return Ok((Got(Op(text([c]))), i + 1))
  Err("unexpected character `${text([c])}`")
)

text : List(U8) -> Str
text(bytes) -> Str.from_utf8(bytes).ok_or("?")

# A name, taking `::` into it, so `file::label` is one word.
name : (List(U8), Nat) -> (Lexed, Nat)
name(line, start) -> (
  i = start
  while i < line.len() do (
    c = line.get_or(i, 0)
    step = if is_name(c) then 1 else if c == ':' & line.get_or(i + 1, 0) == ':' then 2 else 0
    if step == 0 break
    i = i + step
  )
  (Got(Word(text(line.drop(start).take(i - start)))), i)
)

number : (List(U8), Nat) -> Result((Lexed, Nat), Str)
number(line, start) -> (
  i = start
  while i < line.len() & is_name(line.get_or(i, 0)) do (
    i = i + 1
  )
  value = parse_int(text(line.drop(start).take(i - start)))?
  Ok((Got(Number(value)), i))
)

# Parses an integer as Python's `int(x, 0)` does, a leading `-` giving its
# two's complement.
parse_int : Str -> Result(U64, Str)
parse_int(written) -> (
  negative = written.starts_with("-")
  digits = written.drop_prefix("-")
  (radix, body) = if digits.starts_with("0x") then (16, digits.drop_prefix("0x"))
    else if digits.starts_with("0b") then (2, digits.drop_prefix("0b"))
    else if digits.starts_with("0o") then (8, digits.drop_prefix("0o"))
    else (10, digits)
  if body.is_empty() return Err("invalid integer: ${written}")
  value = 0
  for c in body.to_utf8() do (
    if c == '_' continue
    digit = digit_value(c)
    if digit >= radix return Err("invalid integer: ${written}")
    value = value * radix + digit
  )
  word = U64.from_nat(value).map_err(|_| "integer too large: ${written}")?
  Ok(if negative then U64.zero - word else word)
)

digit_value : U8 -> Nat
digit_value(c) if is_digit(c) -> (c - '0').to_nat()
digit_value(c) if c >= 'a' & c <= 'f' -> (c - 'a').to_nat() + 10
digit_value(c) if c >= 'A' & c <= 'F' -> (c - 'A').to_nat() + 10
digit_value(_) -> 99

# The byte after a backslash.
escaped : U8 -> U8
escaped('n') -> '\n'
escaped('t') -> '\t'
escaped('r') -> '\r'
escaped('0') -> 0
escaped(c) -> c

character : (List(U8), Nat) -> Result((Lexed, Nat), Str)
character(line, i) -> (
  c = line.get_or(i, 0)
  (value, close) = if c == '\\' then (escaped(line.get_or(i + 1, 0)), i + 2) else (c, i + 1)
  if line.get_or(close, 0) != '\'' return Err("unterminated character literal")
  Ok((Got(Number(U64.of_nat(value.to_nat()))), close + 1))
)

string : (List(U8), Nat) -> Result((Lexed, Nat), Str)
string(line, start) -> (
  bytes = []
  i = start
  while i < line.len() do (
    c = line.get_or(i, 0)
    if c == '"' return Ok((Got(Text(bytes)), i + 1))
    if c == '\\' then (
      bytes = bytes.append(escaped(line.get_or(i + 1, 0)))
      i = i + 2
    ) else (
      bytes = bytes.append(c)
      i = i + 1
    )
  )
  Err("unterminated string")
)

expect tokenize("loop: add r1, -5 ; note".to_utf8()) == Ok([Word("loop"), Op(":"), Word("add"), Word("r1"), Op(","), Op("-"), Number(U64.of_nat(5))])
expect tokenize("x::.y << 0x1_0 'a'".to_utf8()) == Ok([Word("x::.y"), Op("<<"), Number(U64.of_nat(16)), Number(U64.of_nat(97))])
expect tokenize("\"hi\\n\"".to_utf8()) == Ok([Text("hi\n".to_utf8())])
expect parse_int("-1") == Ok(U64.zero - U64.of_nat(1))
expect parse_int("0b101") == Ok(U64.of_nat(5))
expect is_local("a::.b") & !is_local("a")
