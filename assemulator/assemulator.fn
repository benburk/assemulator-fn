# Assemulator: an assembler and emulator for any toy processor that tells
# it how to encode an instruction (`InstructionSet`) and how to step
# (`Processor`). A processor's program is a few small functions and
#
#   main!(host) -> assemulator!(host, MyIsa)

package {}

import instruction_set {Argument.*, InstructionSet, field, lowered, named, position}
import processor {Step.*, Processor}
import assembler {Assembly, Sources, assemble}
import ports {Ports, PortRead, ports_new, port_read, port_write}
import run {assemulator!, load!, hex}

export {Argument.*, Assembly, Sources, InstructionSet, assemble, field, lowered, named, position, Ports, PortRead, Step.*, Processor, ports_new, port_read, port_write, assemulator!, load!, hex}
