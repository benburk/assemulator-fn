# Splits one line of assembly into tokens. A comment runs from `;` to the
# end of the line. Numbers are decimal, `0x` hexadecimal, `0b` binary or `0o`
# octal, and may part their digits with `_`; a character literal is its byte.

export {Token.*, tokenize, parse_int, is_local}

Token : [
  # A name: an opcode, register, label or directive, perhaps `.`-prefixed
  # and `::`-qualified, as `string::.loop`.
  Word(Str),
  Number(U64),
  # A string literal's bytes, escapes resolved.
  Text(List(U8)),
  # Punctuation and operators.
  Op(Str),
].(
  to_str : Token -> Str
  to_str(Word(w)) -> w
  to_str(Number(n)) -> "${n}"
  to_str(Text(bytes)) -> "\"${Str.from_utf8(bytes).ok_or("?")}\""
  to_str(Op(op)) -> op

  equals : (Token, Token) -> Bool
)

# Whether a name is a local label: its last `::` part begins with `.`.
is_local : Str -> Bool
is_local(name) -> name.split("::").last().ok_or(name).starts_with(".")

tokenize : List(U8) -> Result(List(Token), Str)
tokenize(line) -> lexed(line, [])

# The tokens of `line` after `tokens`, up to a comment.
lexed : (List(U8), List(Token)) -> Result(List(Token), Str)
lexed([], tokens) -> Ok(tokens)
lexed([';', *_], tokens) -> Ok(tokens)
lexed([c, *rest], tokens) if c == ' ' | c == '\t' | c == '\r' -> lexed(rest, tokens)
lexed(line, tokens) -> (
  (token, rest) = token_of(line)?
  lexed(rest, tokens.append(token))
)

is_digit : U8 -> Bool
is_digit(c) -> c >= '0' & c <= '9'

is_name_start : U8 -> Bool
is_name_start(c) -> c.is_ascii_letter() | c == '_' | c == '.'

is_name : U8 -> Bool
is_name(c) -> is_name_start(c) | is_digit(c)

text : List(U8) -> Str
text(bytes) -> Str.from_utf8(bytes).ok_or("?")

byte_word : U8 -> U64
byte_word(c) -> U64.of_nat(c.to_nat())

# The token `line` begins with, and what follows it.
token_of : List(U8) -> Result((Token, List(U8)), Str)
token_of(line is [c, *_]) if is_digit(c) -> (
  digits = line.take_while(is_name)
  value = parse_int(text(digits))?
  Ok((Number(value), line.drop(digits.len())))
)
token_of(line is [c, *_]) if is_name_start(c) -> (
  length = name_length(line)
  Ok((Word(text(line.take(length))), line.drop(length)))
)
token_of(['\'', '\\', c, '\'', *rest]) -> Ok((Number(byte_word(escaped(c))), rest))
token_of(['\'', c, '\'', *rest]) -> Ok((Number(byte_word(c)), rest))
token_of(['\'', *_]) -> Err("unterminated character literal")
token_of(['"', *rest]) -> quoted(rest, [])
token_of([a, b, *rest]) if ["<<", ">>", "<=", ">=", "==", "!=", "&&", "||"].contains(text([a, b])) -> Ok((Op(text([a, b])), rest))
token_of([c, *rest]) if "+-*/%&|^~!<>()[],:$".to_utf8().contains(c) -> Ok((Op(text([c])), rest))
token_of([c, *_]) -> Err("unexpected character `${text([c])}`")
token_of([]) -> Err("expected a token")

# How long the name `line` begins with is, taking `::` into it, so
# `file::label` is one word.
name_length : List(U8) -> Nat
name_length([':', ':', *rest]) -> 2 + name_length(rest)
name_length([c, *rest]) if is_name(c) -> 1 + name_length(rest)
name_length(_) -> 0

# A string literal's bytes after its opening quote, `bytes` read so far.
quoted : (List(U8), List(U8)) -> Result((Token, List(U8)), Str)
quoted(['"', *rest], bytes) -> Ok((Text(bytes), rest))
quoted(['\\', c, *rest], bytes) -> quoted(rest, bytes.append(escaped(c)))
quoted([c, *rest], bytes) -> quoted(rest, bytes.append(c))
quoted([], _) -> Err("unterminated string")

# Parses an integer as Python's `int(x, 0)` does, a leading `-` giving its
# two's complement.
parse_int : Str -> Result(U64, Str)
parse_int(written) -> (
  negative = written.starts_with("-")
  digits = written.drop_prefix("-")
  (radix, body) = if digits.starts_with("0x") then (16, digits.drop_prefix("0x"))
    else if digits.starts_with("0b") then (2, digits.drop_prefix("0b"))
    else if digits.starts_with("0o") then (8, digits.drop_prefix("0o"))
    else (10, digits)
  if body.is_empty() return Err("invalid integer: ${written}")
  digits = body.to_utf8().filter(|c| c != '_').try_map(|c| digit_in(c, radix)).map_err(|_| "invalid integer: ${written}")?
  value = digits.fold(0, |value, digit| value * radix + digit)
  word = U64.from_nat(value).map_err(|_| "integer too large: ${written}")?
  Ok(if negative then U64.zero - word else word)
)

# A digit's value, where it is one in `radix`.
digit_in : (U8, Nat) -> Result(Nat, [NotDigit])
digit_in(c, radix) -> (
  value = digit_value(c)
  if value < radix then Ok(value) else Err(NotDigit)
)

digit_value : U8 -> Nat
digit_value(c) if is_digit(c) -> (c - '0').to_nat()
digit_value(c) if c >= 'a' & c <= 'f' -> (c - 'a').to_nat() + 10
digit_value(c) if c >= 'A' & c <= 'F' -> (c - 'A').to_nat() + 10
digit_value(_) -> 99

# The byte after a backslash.
escaped : U8 -> U8
escaped('n') -> '\n'
escaped('t') -> '\t'
escaped('r') -> '\r'
escaped('0') -> 0
escaped(c) -> c

expect tokenize("loop: add r1, -5 ; note".to_utf8()) == Ok([Word("loop"), Op(":"), Word("add"), Word("r1"), Op(","), Op("-"), Number(U64.of_nat(5))])
expect tokenize("x::.y << 0x1_0 'a'".to_utf8()) == Ok([Word("x::.y"), Op("<<"), Number(U64.of_nat(16)), Number(U64.of_nat(97))])
expect tokenize("\"hi\\n\"".to_utf8()) == Ok([Text("hi\n".to_utf8())])
expect parse_int("-1") == Ok(U64.zero - U64.of_nat(1))
expect parse_int("0b101") == Ok(U64.of_nat(5))
expect is_local("a::.b") & !is_local("a")
